(defvar volume false)
(defpoll current-volume :interval "1s" :initial "0" "pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | sed 's/%//'")
(defpoll volume-icon :interval "1s" "~/.config/eww/scripts/get-volume-icons.sh")
